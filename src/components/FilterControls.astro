---
import type { Category, Publisher } from '../types/game';

/**
 * Props for the catalog filter controls.
 * `categories` and `publishers` provide the native checkbox and select options,
 * while `gameCount` supplies the initial live result announcement.
 */
interface Props {
    categories: Category[];
    publishers: Publisher[];
    gameCount: number;
}

const { categories, publishers, gameCount } = Astro.props;
---

<form
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg"
    data-testid="filter-controls"
    aria-labelledby="filter-heading"
>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <h2 id="filter-heading" class="text-xl font-medium text-slate-100">Filter games</h2>
        <button
            type="reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-reset"
        >
            Clear filters
        </button>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <fieldset>
            <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                        <input
                            type="checkbox"
                            name="category"
                            value={category.id}
                            data-filter-category={category.id}
                            data-testid={`filter-category-${category.id}`}
                            class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                        />
                        <span>{category.name}</span>
                    </label>
                ))}
            </div>
        </fieldset>

        <div>
            <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">Publisher</label>
            <select
                id="publisher-filter"
                name="publisher"
                data-testid="filter-publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
        </div>
    </div>

    <p id="filter-results" class="mt-5 text-sm text-slate-300" data-testid="filter-results" role="status" aria-live="polite">
        Showing {gameCount} {gameCount === 1 ? 'game' : 'games'}
    </p>
</form>
